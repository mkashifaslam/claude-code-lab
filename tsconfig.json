{
  "compilerOptions": {
    "module": "commonjs",
    "outDir": "dist",
    "rootDir": "experiments",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2015",
    "allowJs": true,
    "resolveJsonModule": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false
  },
  "include": [
    "experiments/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
